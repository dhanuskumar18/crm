# CRM Service Environment Variables
# Copy this to .env and fill in your values

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
PORT=3001
SERVICE_NAME=crm-service

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm_db?schema=public"

# ============================================================
# RABBITMQ (Optional - service works without it using Outbox)
# ============================================================
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# RABBITMQ_EXCHANGE=crm.events
# RABBITMQ_QUEUE=crm.outbox

# ============================================================
# SWAGGER
# ============================================================
SWAGGER_ENABLED=true
SWAGGER_TITLE=CRM Service API
SWAGGER_DESCRIPTION=CRM Microservice REST API
SWAGGER_VERSION=1.0
